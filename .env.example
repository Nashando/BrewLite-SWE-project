# Sao chép thành .env ở thư mục gốc. Không commit file .env.
# Tất cả đều có giá trị mặc định cho local trong docker-compose.yml, chỉ cần đổi khi muốn khác.

# ---- Database ----
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite
POSTGRES_DB=brewlite

# Dùng khi chạy API, migrate hoặc seed trên máy host. Trong Docker, compose tự đặt host là "db".
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# ---- API (apps/api) ----
PORT=3001
# Bắt buộc đổi khi triển khai thật
JWT_SECRET=change-me-in-local-only
JWT_EXPIRES_IN=1d
# Nhiều origin thì ngăn cách bằng dấu phẩy
CORS_ORIGIN=http://localhost:3000

# ---- Web (apps/web) ----
# URL mà trình duyệt dùng để gọi API. Được nhúng vào bundle lúc build.
NEXT_PUBLIC_API_URL=http://localhost:3001
