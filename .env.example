###############################################################################
# BREWLITE MONOREPO - ENVIRONMENT VARIABLES TEMPLATE
#
# Đây là tệp mẫu cấu hình biến môi trường.
# Sao chép tệp này thành .env ở thư mục gốc để sử dụng.
# Tuyệt đối KHÔNG commit mật khẩu hoặc secret thực tế lên kho mã nguồn!
###############################################################################

# -----------------------------------------------------------------------------
# 1. CẤU HÌNH HỆ THỐNG & BACKEND API (apps/api - NestJS)
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
APP_NAME=BrewLite-API
API_PREFIX=/api/v1
# Cho phép frontend Next.js gọi API (ngăn cách bằng dấu phẩy nếu có nhiều origin)
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# 2. CẤU HÌNH CƠ SỞ DỮ LIỆU (PostgreSQL & Prisma)
# -----------------------------------------------------------------------------
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite
POSTGRES_DB=brewlite
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Chuỗi kết nối PostgreSQL dùng cho NestJS, Prisma migrate & seed
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# -----------------------------------------------------------------------------
# 3. CẤU HÌNH BẢO MẬT & XÁC THỰC (JWT Authentication)
# -----------------------------------------------------------------------------
# Khóa bí mật mã hóa JWT Token (Bắt buộc thay đổi trên Production!)
JWT_SECRET=brewlite_super_secret_jwt_key_minimum_32_characters_long
JWT_EXPIRES_IN=1d

# -----------------------------------------------------------------------------
# 4. CẤU HÌNH FRONTEND APP (apps/web - Next.js PWA)
# -----------------------------------------------------------------------------
# URL của Backend API mà Frontend Next.js gọi tới
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=BrewLite

# -----------------------------------------------------------------------------
# 5. CẤU HÌNH DỊCH VỤ THANH TOÁN MÔ PHỎNG (Mock Payment)
# -----------------------------------------------------------------------------
MOCK_PAYMENT_GATEWAY_URL=http://localhost:3001/api/v1/payment/mock
MOCK_PAYMENT_SECRET=mock_payment_secret_key_123

# -----------------------------------------------------------------------------
# 6. PHẠM VI NGOÀI NGHIỆP VỤ (Out-of-Scope Notes)
# -----------------------------------------------------------------------------
# - Không tích hợp cổng thanh toán thật (Momo / VNPay / ZaloPay API keys -> N/A)
# - Không tích hợp đơn vị giao hàng (Delivery Service API keys -> N/A)
# - Không tích hợp hệ thống quản lý nhân sự / lương (HR Service -> N/A)
