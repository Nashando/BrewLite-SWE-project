###############################################################################
# BREWLITE MONOREPO - ENVIRONMENT VARIABLES TEMPLATE
#
# Đây là tệp mẫu cấu hình biến môi trường.
# Sao chép tệp này thành .env ở thư mục gốc để sử dụng.
# Tuyệt đối KHÔNG commit mật khẩu hoặc secret thực tế lên kho mã nguồn!
###############################################################################

# -----------------------------------------------------------------------------
# 1. CẤU HÌNH HỆ THỐNG & BACKEND API (apps/api - NestJS)
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
APP_NAME=BrewLite-API
API_PREFIX=/api/v1
# Cho phép frontend Next.js gọi API (ngăn cách bằng dấu phẩy nếu có nhiều origin)
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# 2. CẤU HÌNH CƠ SỞ DỮ LIỆU (PostgreSQL & Prisma)
# -----------------------------------------------------------------------------
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite
POSTGRES_DB=brewlite
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Chuỗi kết nối PostgreSQL dùng cho NestJS, Prisma migrate & seed
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# -----------------------------------------------------------------------------
# 3. CẤU HÌNH BẢO MẬT & XÁC THỰC (JWT Authentication - ADR 003)
# -----------------------------------------------------------------------------
# Giá trị dưới đây CHỈ để chạy local. Production: tạo chuỗi ngẫu nhiên >= 32 ký tự, ví dụ:
#   openssl rand -base64 48
JWT_SECRET=change-me-local-only-use-at-least-32-characters
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-local-only-refresh-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# 4. CẤU HÌNH NGHIỆP VỤ ĐƠN HÀNG & TỒN KHO (Order Expiry & TTL)
# -----------------------------------------------------------------------------
# Thời gian chờ thanh toán trước khi đơn hết hạn và hoàn lại tồn kho (phút)
ORDER_PAYMENT_TTL_MINUTES=15

# -----------------------------------------------------------------------------
# 5. CẤU HÌNH FRONTEND APP (apps/web - Next.js PWA)
# -----------------------------------------------------------------------------
# URL của Backend API mà Frontend Next.js gọi tới
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=BrewLite

# Bật/tắt mock API (MSW) khi phát triển giao diện độc lập: enabled | disabled
NEXT_PUBLIC_API_MOCKING=disabled

# -----------------------------------------------------------------------------
# 6. PHẠM VI NGOÀI NGHIỆP VỤ (Out-of-Scope Notes)
# -----------------------------------------------------------------------------
# - Không tích hợp cổng thanh toán bên thứ ba thật (Mock Payment xử lý in-app qua ADR 004)
# - Không tích hợp đơn vị giao hàng (Delivery Service API keys -> N/A)
# - Không tích hợp hệ thống quản lý nhân sự / lương (HR Service -> N/A)
