    ###############################################################################
    # BREWLITE MONOREPO - ENVIRONMENT VARIABLES TEMPLATE
    #
    # Đây là tệp mẫu cấu hình biến môi trường.
    # Tuyệt đối KHÔNG commit mật khẩu hoặc secret thực tế lên kho mã nguồn!
    ###############################################################################

    # -----------------------------------------------------------------------------
    # 1. CẤU HÌNH HỆ THỐNG & BACKEND API (apps/api - NestJS)
    # -----------------------------------------------------------------------------
    NODE_ENV=development
    PORT=3000
    APP_NAME=BrewLite-API
    API_PREFIX=/api/v1

    # -----------------------------------------------------------------------------
    # 2. CẤU HÌNH CƠ SỞ DỮ LIỆU (PostgreSQL & Prisma Migration)
    # -----------------------------------------------------------------------------
    POSTGRES_USER=postgres
    POSTGRES_PASSWORD=postgres_password_change_me
    POSTGRES_DB=brewlite_db
    POSTGRES_HOST=localhost
    POSTGRES_PORT=5432

    # Chuỗi kết nối CSDL PostgreSQL dành cho NestJS & Prisma.
    # Nếu thư viện đọc .env không hỗ trợ nội suy biến, hãy thay các biến bên dưới
    # bằng giá trị tương ứng trong DATABASE_URL.
    DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

    # -----------------------------------------------------------------------------
    # 3. CẤU HÌNH BẢO MẬT & XÁC THỰC (JWT Authentication)
    # -----------------------------------------------------------------------------
    # Khóa bí mật mã hóa JWT Token (Bắt buộc thay đổi trên Production!)
    JWT_SECRET=brewlite_super_secret_jwt_key_minimum_32_characters_long
    JWT_EXPIRES_IN=1d

    # -----------------------------------------------------------------------------
    # 4. CẤU HÌNH FRONTEND APP (apps/web - Next.js PWA)
    # -----------------------------------------------------------------------------
    # Địa chỉ URL của Backend API mà Frontend Next.js sẽ gọi tới.
    NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
    NEXT_PUBLIC_APP_NAME=BrewLite

    # -----------------------------------------------------------------------------
    # 5. CẤU HÌNH DỊCH VỤ THANH TOÁN MÔ PHỎNG (Mock Payment & Idempotency)
    # -----------------------------------------------------------------------------
    MOCK_PAYMENT_GATEWAY_URL=http://localhost:3000/api/v1/payment/mock
    MOCK_PAYMENT_SECRET=mock_payment_secret_key_123

    # -----------------------------------------------------------------------------
    # 6. PHẠM VI NGOÀI NGHIỆP VỤ (Out-of-Scope Notes)
    # -----------------------------------------------------------------------------
    # - Không tích hợp cổng thanh toán thật (Momo / VNPay / ZaloPay API keys -> N/A)
    # - Không tích hợp đơn vị giao hàng (Delivery Service API keys -> N/A)
    # - Không tích hợp hệ thống quản lý nhân sự / lương (HR Service -> N/A)