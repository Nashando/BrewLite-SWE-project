generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  MANAGER
}

enum OrderStatus {
  PENDING_PAYMENT // đã tạo đơn, giữ hàng, chờ thanh toán (tự huỷ sau 15 phút)
  PAID // đã thanh toán, chờ quầy xử lý
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  WALLET // ví mô phỏng, trừ vào số dư của tài khoản
  CARD // thẻ mô phỏng, chỉ lưu 4 số cuối
  CASH // phần mở rộng: trả tại quầy, nhân viên xác nhận đã thu tiền
}

enum PaymentStatus {
  PENDING // tiền mặt đang chờ thu tại quầy
  SUCCESS
  FAILED
  REFUNDED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String
  role          Role     @default(CUSTOMER)
  walletBalance Int      @default(200000) // ví mô phỏng (VND)
  createdAt     DateTime @default(now())

  cart   Cart?
  orders Order[]
}

model Product {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  category    String
  basePrice   Int // VND
  imageUrl    String?
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  sizes      ProductSize[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([category])
}

model ProductSize {
  id         String @id @default(uuid())
  productId  String
  name       String // S / M / L
  extraPrice Int    @default(0)

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@unique([productId, name])
}

model Topping {
  id       String  @id @default(uuid())
  name     String  @unique
  price    Int
  isActive Boolean @default(true)

  cartItems CartItem[]
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  sizeId    String?
  quantity  Int
  createdAt DateTime @default(now())

  cart     Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product  Product      @relation(fields: [productId], references: [id])
  size     ProductSize? @relation(fields: [sizeId], references: [id])
  toppings Topping[]
}

model Order {
  id          String      @id @default(uuid())
  code        String      @unique // mã tra cứu đơn, vd BL-3F9A12CD
  userId      String
  status      OrderStatus @default(PENDING_PAYMENT)
  totalAmount Int
  note        String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user     User        @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([status, createdAt])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  productName String // snapshot tại thời điểm đặt
  sizeName    String?
  toppings    Json    @default("[]") // snapshot [{name, price}]
  unitPrice   Int
  quantity    Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String
  userId         String
  method         PaymentMethod
  status         PaymentStatus
  amount         Int
  idempotencyKey String
  transactionRef String        @unique // mã giao dịch ngẫu nhiên của cổng mô phỏng
  cardLast4      String?
  failureReason  String?
  createdAt      DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([orderId])
}
