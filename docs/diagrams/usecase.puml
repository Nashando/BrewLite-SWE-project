@startuml usecase
title BrewLite - Use-case tổng quát (Task 1.2)
left to right direction
skinparam shadowing false
skinparam actorStyle outline
actor "Khách vãng lai" as Guest
actor "Khách hàng\nCUSTOMER" as Customer
actor "Nhân viên\nSTAFF" as Staff
actor "Quản lý\nMANAGER" as Manager
Guest <|-- Customer
Staff <|-- Manager
rectangle "BrewLite" {
  usecase "UC-MENU: Xem/tìm/lọc menu\nFR-01, FR-09" as Menu
  usecase "UC-DETAIL: Chi tiết, size, topping\nFR-02" as Detail
  usecase "UC-CART: Giỏ hàng\nFR-03" as Cart
  usecase "UC-AUTH: Đăng ký/đăng nhập\nFR-04" as Auth
  usecase "UC-CHECKOUT: Đặt/thanh toán\nFR-05" as Checkout #LightSkyBlue
  usecase "Kiểm JWT và vai trò\nNFR-02" as Jwt
  usecase "UC-HISTORY: Lịch sử/theo dõi\nFR-06" as History
  usecase "UC-COUNTER: Xử lý đơn, thu CASH\nFR-07" as Counter
  usecase "UC-CANCEL: Hủy trước pha chế\nFR-08" as Cancel
  usecase "UC-CATALOG: Menu/topping/kho\nFR-10" as Catalog
  usecase "UC-REVENUE: Doanh thu\nFR-11" as Revenue
}
Guest --> Menu
Guest --> Detail
Guest --> Cart
Guest --> Auth
Customer --> Checkout
Customer --> History
Customer --> Cancel
Staff --> Menu
Staff --> Detail
Staff --> Counter
Staff --> Cancel
Manager --> Catalog
Manager --> Revenue
Checkout ..> Jwt : <<include>>
note bottom of Checkout
  PaymentService mô phỏng nằm trong NestJS.
  Đăng nhập là luồng thay thế nếu chưa có phiên;
  không phải đăng nhập lại ở mọi checkout.
end note
note bottom of Counter
  STAFF/MANAGER không đặt hoặc thanh toán đơn cho mình.
  Promotion/Loyalty chỉ có trong mô hình domain mở rộng,
  chưa là chức năng thực thi.
end note
@enduml
