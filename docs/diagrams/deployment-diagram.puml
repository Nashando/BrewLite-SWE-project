@startuml deployment-diagram
title BrewLite - Deployment hiện trạng source 9808d37 (Task 3.2)
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13

cloud "Container registry: Docker Hub\nBase images khai báo trong source" as registry {
  artifact "node:22-alpine\npostgres:16-alpine" as baseimages
}
node "Local (cấu hình Compose, chưa chạy Docker trên máy QA)" {
  artifact "Web :3000 / API :3001 / DB :5432\nHost bind 127.0.0.1; cổng thay qua env" as localapps
  database "pgdata\nPersistent local volume" as localdata
}
node "GitHub Actions - CI/CD" as ci {
  component "quality\nInstall / Lint / Unit / Build API + web" as quality
  component "deploy-api\nPOST Render Hook + ref SHA" as deploy
  component "smoke-test\nGET health / products / menu" as smoke
  quality -right-> deploy
  deploy -right-> smoke
}
node "Production theo cấu hình repo" {
  node "Thiết bị người dùng" {
    component "Mobile / Desktop Browser\nweb app manifest" as browser
  }
  node "Vercel\nGit Integration main" {
    artifact "Next.js SSR / static assets\napps/web" as web
  }
  node "Render Web Service\nNode runtime từ Git" {
    artifact "NestJS API + PaymentService nội bộ\napps/api; HTTP PORT (default 3001)" as api
    artifact "start:migrate\nprisma migrate deploy → API start" as migrate
  }
  database "Render PostgreSQL\nInternal TCP 5432\nPersistent storage" as db
  browser -down-> web : HTTPS 443
  browser -down-> api : HTTPS 443 / CORS
  api -right-> db : DATABASE_URL nội bộ
  migrate --> db : migration trước server
  note right of web
    Build env public: NEXT_PUBLIC_API_URL,
    NEXT_PUBLIC_API_MOCKING=disabled.
    Logs: Vercel Dashboard.
  end note
  note right of api
    Runtime env: DATABASE_URL, JWT_*,
    CORS_ORIGIN, PORT; health path /health.
    Logs: Render Dashboard.
  end note
}
baseimages --> localapps : Dockerfiles / Compose
localapps --> localdata
deploy --> api : HTTPS secret Deploy Hook
smoke ..> api : /health + /products
smoke ..> web : /menu
note left of deploy
  Secret: RENDER_DEPLOY_HOOK_URL
  GitHub environment production.
end note
note bottom of ci
  Trigger CD: tag vX.Y.Z. Vercel deploy web độc lập.
  Không có executable job build/push app image GHCR.
  Task 5.3 app-image/tag/registry vẫn còn mở.
end note
note bottom of db
  DB private, backup và cấu hình runtime cần bằng chứng Dashboard.
  Internal URL / health up không tự xác nhận external access bị khóa.
end note
@enduml
