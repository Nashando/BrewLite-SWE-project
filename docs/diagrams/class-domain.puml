@startuml class-domain
title Class - Domain model BrewLite
hide empty methods
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor<<mở rộng>> #F5F5F5
  BorderColor<<mở rộng>> #9E9E9E
  FontColor<<mở rộng>> #616161
}

enum Role {
  CUSTOMER
  STAFF
  MANAGER
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  WALLET
  CARD
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum LoyaltyTxType <<mở rộng>> {
  EARN
  REDEEM
}

class User {
  + id: UUID
  + email: String {unique}
  {field} + password: String (bcrypt)
  + name: String
  + role: Role
  {field} + walletBalance: Integer (VND)
  + createdAt: DateTime
}

class Product {
  + id: UUID
  + name: String {unique}
  + description: String
  + category: String
  {field} + basePrice: Integer (VND)
  + stock: Integer
  + isActive: Boolean
}

class ProductSize {
  + id: UUID
  + name: String
  {field} + extraPrice: Integer (VND)
}

class Topping {
  + id: UUID
  + name: String {unique}
  {field} + price: Integer (VND)
  + isActive: Boolean
}

class Cart {
  + id: UUID
  + updatedAt: DateTime
}

class CartItem {
  + id: UUID
  + quantity: Integer
}

class Order {
  + id: UUID
  + code: String {unique}
  + status: OrderStatus
  {field} + totalAmount: Integer (VND)
  + note: String
  + createdAt: DateTime
  + updatedAt: DateTime
  + isPayable(): Boolean
  + canCancel(): Boolean
}

class OrderItem {
  + id: UUID
  + productName: String
  + sizeName: String
  {field} + toppings: JSON (tên, giá)
  {field} + unitPrice: Integer (VND)
  + quantity: Integer
}

class Payment {
  + id: UUID
  + method: PaymentMethod
  + status: PaymentStatus
  {field} + amount: Integer (VND)
  + idempotencyKey: String
  + transactionRef: String {unique}
  + cardLast4: String
  + failureReason: String
  + createdAt: DateTime
}

class Promotion <<mở rộng>> {
  + id: UUID
  + code: String {unique}
  + discountPercent: Integer
  {field} + maxDiscount: Integer (VND)
  + validFrom: DateTime
  + validTo: DateTime
  + isActive: Boolean
}

class LoyaltyTransaction <<mở rộng>> {
  + id: UUID
  + points: Integer
  + type: LoyaltyTxType
  + createdAt: DateTime
}

User "1" -- "0..1" Cart : sở hữu >
Cart "1" *-- "0..*" CartItem : chứa >
CartItem "0..*" --> "1" Product : món >
CartItem "0..*" --> "0..1" ProductSize : size >
CartItem "0..*" --> "0..*" Topping : topping >
Product "1" *-- "0..*" ProductSize : có >

User "1" -- "0..*" Order : đặt >
Order "1" *-- "1..*" OrderItem : gồm >
OrderItem "0..*" --> "1" Product : món >
Order "1" -- "0..*" Payment : thanh toán qua >

Promotion "0..1" -- "0..*" Order : áp dụng cho >
User "1" -- "0..*" LoyaltyTransaction : có >
Order "0..1" -- "0..*" LoyaltyTransaction : tạo ra >

User ..> Role
Order ..> OrderStatus
Payment ..> PaymentMethod
Payment ..> PaymentStatus
LoyaltyTransaction ..> LoyaltyTxType

note right of OrderItem
  Lưu bản chụp tên và giá lúc đặt,
  để đơn cũ không đổi khi giá món đổi.
end note

note bottom of Payment
  Một đơn có thể có nhiều lần thanh toán (thử lại).
  Duy nhất theo (userId, idempotencyKey).
  Thẻ chỉ lưu 4 số cuối.
end note

note bottom of Promotion
  Phần mở rộng: có trong mô hình domain,
  chưa có bảng trong cơ sở dữ liệu.
end note

note bottom of Cart
  Bảng giỏ hàng có trong cơ sở dữ liệu,
  giao diện hiện lưu giỏ trong trình duyệt.
end note
@enduml
