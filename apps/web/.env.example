# URL của NestJS API mà TRÌNH DUYỆT gọi tới.
# Giá trị được nhúng vào bundle lúc build, nên khi build Docker phải truyền qua build arg.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Bật MSW (mock API) để làm giao diện khi backend chưa sẵn sàng: enabled | disabled
# Lần đầu cần chạy `npm run mocks:init` để sinh public/mockServiceWorker.js
NEXT_PUBLIC_API_MOCKING=enabled
